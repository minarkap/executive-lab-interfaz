#!/bin/bash
# Se ejecuta al terminar de copiar los ficheros del .pkg.
#
# Corre como root pero el trabajo es del alumno, así que todo lo que toque su
# carpeta se hace con su usuario: si no, acaba con ficheros que no puede editar.

set -u

APP="/usr/local/executive-lab"
USUARIO="$(stat -f%Su /dev/console)"
CASA=$(eval echo "~$USUARIO")

# node y git al alcance de los hooks del arnés, que los llaman por nombre.
# /usr/local/bin está en /etc/paths, y VS Code en macOS resuelve el PATH del
# shell al arrancar. Solo si no hay ya uno: no pisamos lo que tuviera.
mkdir -p /usr/local/bin
[ -e /usr/local/bin/node ] || ln -s "$APP/runtime/bin/node" /usr/local/bin/node
[ -e /usr/local/bin/npx ]  || ln -s "$APP/runtime/bin/npx"  /usr/local/bin/npx
if [ -x "$APP/git/bin/git" ] && [ ! -e /usr/local/bin/git ]; then
  ln -s "$APP/git/bin/git" /usr/local/bin/git
fi

# Sin git no hay copias de seguridad. En macOS, el git del sistema pide
# instalar las herramientas de Xcode con un diálogo: si no llevamos git dentro
# y no están, mejor saberlo aquí que en la primera clase.
if [ ! -x "$APP/git/bin/git" ] && ! xcode-select -p >/dev/null 2>&1; then
  echo "AVISO: no hay git en esta máquina y el paquete no lo lleva." >&2
fi

DESTINO="$CASA/Documents/Mi Empresa IA"

# El .pkg no tiene pantalla para elegir objetivo: el asistente lo afina en la
# primera conversación.
sudo -H -u "$USUARIO" env EXECUTIVE_LAB_HOME="$APP" "$APP/runtime/bin/node" "$APP/preparar.js" \
  --destino "$DESTINO" \
  --objetivo "${EL_OBJETIVO:-llevar mi empresa con ayuda de la IA}" \
  --asistente claude

chown -R "$USUARIO" "$DESTINO" 2>/dev/null || true
exit 0
