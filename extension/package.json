{
  "name": "arnes-ui",
  "displayName": "Executive Lab",
  "description": "Convierte VS Code en una sola pantalla sencilla para trabajar con un arnés de IA, sin ver ficheros, rutas ni terminales.",
  "publisher": "executivelab",
  "version": "0.19.0",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Other",
    "Education"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "executiveLab",
          "title": "Mi trabajo",
          "icon": "media/icono.svg"
        }
      ]
    },
    "views": {
      "executiveLab": [
        {
          "id": "executiveLab.panel",
          "name": "Tu trabajo",
          "type": "webview",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "executiveLab.elegirCarpeta",
        "title": "Executive Lab: Elegir la carpeta con la que trabajar"
      },
      {
        "command": "executiveLab.seguir",
        "title": "Executive Lab: Seguir donde lo dejé"
      },
      {
        "command": "executiveLab.empezar",
        "title": "Executive Lab: Empezar algo nuevo"
      },
      {
        "command": "executiveLab.cerebro",
        "title": "Executive Lab: Conocimiento"
      },
      {
        "command": "executiveLab.documentos",
        "title": "Executive Lab: Darle documentos"
      },
      {
        "command": "executiveLab.conexiones",
        "title": "Executive Lab: Conexiones (tools)"
      },
      {
        "command": "executiveLab.guardar",
        "title": "Executive Lab: Guardar en git"
      },
      {
        "command": "executiveLab.algoVaMal",
        "title": "Executive Lab: Algo va mal"
      },
      {
        "command": "executiveLab.empezarEmpresa",
        "title": "Executive Lab: Empezar una empresa aquí"
      },
      {
        "command": "executiveLab.refrescar",
        "title": "Executive Lab: Actualizar la brújula"
      },
      {
        "command": "executiveLab.verEditorCompleto",
        "title": "Executive Lab: Ver el editor completo (solo esta ventana)"
      },
      {
        "command": "executiveLab.modoSencillo",
        "title": "Executive Lab: Volver al modo sencillo (solo esta ventana)"
      },
      {
        "command": "executiveLab.diagnosticoPuente",
        "title": "Executive Lab: Qué comandos hay para hablar con tu asistente"
      },
      {
        "command": "executiveLab.quitarDeTodo",
        "title": "Executive Lab: Quitar el aspecto de todo el editor"
      },
      {
        "command": "executiveLab.ponerLaCara",
        "title": "Executive Lab: Ponerle la cara de tu empresa"
      },
      {
        "command": "executiveLab.radiografia",
        "title": "Executive Lab: Qué falta por montar"
      },
      {
        "command": "executiveLab.copiaFuera",
        "title": "Executive Lab: Subir a GitHub"
      },
      {
        "command": "executiveLab.saberes",
        "title": "Executive Lab: Habilidades (skills)"
      },
      {
        "command": "executiveLab.salidas",
        "title": "Executive Lab: Lo que ha hecho"
      },
      {
        "command": "executiveLab.comandos",
        "title": "Executive Lab: Procesos con un clic"
      },
      {
        "command": "executiveLab.sugerencias",
        "title": "Executive Lab: Sugerencias"
      },
      {
        "command": "executiveLab.agentes",
        "title": "Executive Lab: Ayudantes"
      },
      {
        "command": "executiveLab.proyectos",
        "title": "Executive Lab: En qué estamos"
      },
      {
        "command": "executiveLab.laCara",
        "title": "Executive Lab: El tema de mi empresa"
      },
      {
        "command": "executiveLab.fijadas",
        "title": "Executive Lab: Acciones rápidas"
      },
      {
        "command": "executiveLab.comoTrabaja",
        "title": "Executive Lab: Cómo quieres que trabaje"
      },
      {
        "command": "executiveLab.reglas",
        "title": "Executive Lab: Las reglas"
      },
      {
        "command": "executiveLab.asistente",
        "title": "Executive Lab: Con quién hablas"
      },
      {
        "command": "executiveLab.papeles",
        "title": "Executive Lab: Lo que le has dado"
      },
      {
        "command": "executiveLab.ayuda",
        "title": "Executive Lab: Ayuda"
      },
      {
        "command": "executiveLab.huecos",
        "title": "Executive Lab: Preguntas sin contestar"
      },
      {
        "command": "executiveLab.diario",
        "title": "Executive Lab: El diario"
      },
      {
        "command": "executiveLab.trato",
        "title": "Executive Lab: Cómo te habla"
      }
    ],
    "configuration": {
      "title": "Executive Lab",
      "properties": {
        "executiveLab.guardarSolo": {
          "type": "number",
          "default": 0,
          "enum": [
            0,
            1,
            8
          ],
          "enumDescriptions": [
            "Solo cuando lo pidas",
            "Cada hora",
            "Un par de veces al día"
          ],
          "scope": "resource",
          "description": "Cada cuántas horas se guarda una copia sola, mientras esta ventana esté abierta y haya algo nuevo. Nunca escribe en el historial de otra persona."
        },
        "executiveLab.vistaSencilla": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Esconde las barras, las pestañas y los ficheros de esta carpeta y la deja con el aspecto de Executive Lab. Se enciende y se apaga por carpeta: las demás ventanas no se enteran."
        }
      }
    }
  },
  "scripts": {
    "empaquetar": "node preparar-paquete.js && npx --yes @vscode/vsce package --out executive-lab.vsix --allow-missing-repository --skip-license",
    "probar": "node prueba/humo.js && node prueba/empresas-distintas.js",
    "probar-en-vscode": "npm install --no-save --silent @vscode/test-electron && node prueba/en-vscode/correr.js"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "La barra lateral solo ejecuta cosas cuando el alumno pulsa un botón. El disfraz desactiva la confianza del workspace, así que esto solo importa en el primer arranque."
    },
    "virtualWorkspaces": false
  },
  "icon": "media/icono-marketplace.png",
  "keywords": [
    "executive lab",
    "rsc",
    "arnés",
    "claude",
    "codex",
    "no-code"
  ],
  "galleryBanner": {
    "color": "#f4eee6",
    "theme": "light"
  },
  "qna": false
}
